rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function editor() { return request.auth != null && request.auth.token.get('papel','') in ['admin','editor']; }
    function imagem() { return request.resource.contentType in ['image/jpeg','image/png','image/webp','image/gif']; }
    function permitido() {
      return imagem() || request.resource.contentType in [
        'application/pdf','application/msword','application/vnd.ms-powerpoint','application/vnd.ms-excel','text/plain',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
    }
    // Somente criação. Substituições geram outro nome; versões antigas preservam o arquivo.
    match /materiais/{cursoId}/{arquivo} {
      allow read: if true;
      allow create: if resource == null && editor() && request.resource.size < 40*1024*1024 && permitido();
      allow update, delete: if false;
    }
    match /capas/{arquivo} {
      allow read: if true;
      allow create: if resource == null && editor() && request.resource.size < 3*1024*1024 && imagem();
      allow update, delete: if false;
    }
    match /{caminho=**} { allow read, write: if false; }
  }
}
