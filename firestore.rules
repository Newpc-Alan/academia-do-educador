rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function login() { return request.auth != null; }
    function dono(uid) { return login() && request.auth.uid == uid; }
    function papel() { return login() ? request.auth.token.get('papel','') : ''; }
    function admin() { return papel() == 'admin'; }
    function editor() { return papel() in ['admin','editor']; }
    function curso(cid) { return get(/databases/$(database)/documents/cursos/$(cid)).data; }
    function publicado(cid) { return curso(cid).status == 'publicado'; }
    function editavel(d) {
      return d.status != 'publicado' && !d.get('historicoPublicado',false) && !('publicadoEm' in d);
    }
    function editarConteudo(cid) { return editor() && editavel(curso(cid)); }
    match /equipe/{uid} { allow read: if editor(); allow write: if false; }
    match /auditoria/{id} { allow read: if admin(); allow write: if false; }
    match /cursos/{cid} {
      allow read: if resource.data.status == 'publicado' || editor();
      allow create: if editor() && request.resource.data.status == 'rascunho'
        && !('historicoPublicado' in request.resource.data) && !('publicadoEm' in request.resource.data);
      // Publicação e congelamento apenas via publicarCurso.
      allow update: if editor() && editavel(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status','historicoPublicado','publicadoEm']);
      allow delete: if false;
      match /modulos/{id} { allow read: if publicado(cid) || editor(); allow write: if editarConteudo(cid); }
      match /aulas/{id} { allow read: if publicado(cid) || editor(); allow write: if editarConteudo(cid); }
      match /questoes/{id} { allow read: if editor(); allow write: if editarConteudo(cid); }
      match /gabarito/{id} { allow read: if false; allow write: if editarConteudo(cid); }
    }
    match /trilhas/{id} {
      allow read: if resource.data.status == 'publicado' || editor();
      allow create: if editor() && (request.resource.data.status != 'publicado' || admin());
      allow update: if admin() || (editor() && resource.data.status != 'publicado' && request.resource.data.status != 'publicado');
      allow delete: if admin();
    }
    match /users/{uid} {
      allow read: if dono(uid);
      // Campos de perfil não conferem papéis nem determinam progresso.
      allow create, update: if dono(uid)
        && request.resource.data.keys().hasOnly(['nome','email','fotoURL','municipio','escola','cargo','cpf','aceiteTermos','criadoEm','ultimoAcesso'])
        && request.resource.data.get('nome','') is string && request.resource.data.get('nome','').size() <= 160
        && request.resource.data.get('cpf','') is string && request.resource.data.get('cpf','').size() <= 20
        && request.resource.data.get('municipio','') is string && request.resource.data.get('municipio','').size() <= 160
        && request.resource.data.get('escola','') is string && request.resource.data.get('escola','').size() <= 240
        && request.resource.data.get('email','') == request.auth.token.get('email','');
      allow delete: if false;
      match /progresso/{cid} { allow read: if dono(uid); allow write: if false; }
      match /tentativas/{cid} { allow read: if dono(uid); allow write: if false; }
      match /anotacoes/{aid} {
        allow read, delete: if dono(uid);
        allow create, update: if dono(uid) && request.resource.data.keys().hasOnly(['texto','atualizadoEm'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 12000
          && request.resource.data.atualizadoEm == request.time;
      }
      match /provas/{id} { allow read, write: if false; }
      match /sessoes/{id} { allow read, write: if false; }
      match /emissoes/{id} { allow read, write: if false; }
    }
    // Dados completos só para titular e administrador. Sem leitura pública.
    // consultarCertificado devolve uma projeção mínima, inclusive de registros antigos.
    match /certificados/{codigo} { allow read: if admin() || (login() && resource.data.uid == request.auth.uid); allow write: if false; }
    // Vínculo CPF -> conta, criado na primeira emissão. Fechado nos dois sentidos:
    // é o que impede emitir certificado com o CPF de outra pessoa.
    match /cpfs/{cpf} { allow read, write: if false; }
    match /municipios/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
